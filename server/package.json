{
  "name": "karsa-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "One container: room service (NestJS) and document sync (Hocuspocus) in one process, SQLite on disk.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/main.js",
    "dev": "tsc -p tsconfig.json && node --experimental-sqlite dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^4.7.0",
    "@hocuspocus/server": "^4.7.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
