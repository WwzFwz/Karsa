{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      // onnxruntime-web ships types but leaves them out of its "exports" map,
      // so bundler resolution cannot find them. Pointing at the file directly
      // keeps the runtime import ordinary and the types real.
      "onnxruntime-web": ["node_modules/onnxruntime-web/types.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
