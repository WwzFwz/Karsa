# Salin jadi .env untuk mengubah bawaan saat membangun.
# Semua nilai di sini juga bisa diganti per perangkat lewat halaman Pengaturan.

# Model bahasa lokal. Untuk pemasangan ter-deploy, biarkan localhost:
# aplikasinya disajikan server, modelnya tetap di mesin masing-masing pendengar.
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen2.5:7b

# Server sinkronisasi. Jalur berarti server asal halaman ini; "off" = hanya perangkat ini.
VITE_SYNC_URL=/sync
# Room service (buat ruang, masuk, ruang tunggu). Jalur = server asal halaman.
VITE_API_URL=/api

# Untuk server (server/), dibaca dari lingkungan, bukan dari berkas ini:
#   KARSA_SECRET      wajib di produksi; penanda tangan token masuk ruang
#   KARSA_DATA        berkas SQLite, bawaan server/data/karsa.sqlite
#   KARSA_TOKEN_DAYS  masa berlaku token, bawaan 30
#   KARSA_MODELS      folder berkas model ucapan; disajikan di /models
#   PORT              bawaan 3000

# Pengenalan suara di peramban.
VITE_ASR_MODEL=onnx-community/whisper-base
VITE_ASR_MODEL_ACCURATE=onnx-community/whisper-small

# Dari mana berkas modelnya diambil. Kosong = CDN Hugging Face, perlu internet
# pada kalimat pertama. Isi "/models" untuk mengambilnya dari server asal
# halaman -- itu yang membuat mode kelas benar-benar jalan tanpa internet:
#
#   npm run models                      unduh sekali di mesin yang punya internet
#   KARSA_MODELS=models npm run dev:server    server menyajikannya
#   VITE_MODEL_URL=/models npm run build      klien mengambilnya dari sana
#
VITE_MODEL_URL=
