{
  "name": "karsa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-ort.mjs && vite",
    "build": "node scripts/prepare-ort.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/test.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "eval": "node scripts/eval.mjs",
    "models": "node scripts/fetch-models.mjs",
    "check": "npm run typecheck && npm run typecheck:server && npm run check:boundaries && npm test && npm run eval",
    "shots": "node scripts/shots.mjs",
    "dev:server": "npm --prefix server run dev",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "test:server": "npm --prefix server run build && node --test scripts/server-e2e.mjs",
    "test:people": "npm --prefix server run build && node --test scripts/two-people.mjs",
    "bench:layout": "node scripts/bench-layout.mjs",
    "big-room": "node scripts/big-room.mjs"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.7.0",
    "@huggingface/transformers": "^3.8.1",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
